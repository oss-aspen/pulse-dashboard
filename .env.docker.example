# Docker local development — copy to .env and replace the placeholders.
COMPOSE_PROFILES=upstream
UPSTREAM_PULSE_DIR=../upstream-pulse
UPSTREAM_DB_PORT=5433
# Required on macOS with Podman; set false on Linux / Docker Desktop if file events work.
DEV_POLLING=true

# Pulse core (live data)
ADMIN_EMAILS=you@redhat.com
JIRA_HOST=https://redhat.atlassian.net
JIRA_EMAIL=you@redhat.com
JIRA_TOKEN=your-jira-api-token
# Required for the full stack; use a classic PAT with read:user, repo, and read:org.
GITHUB_TOKEN=
GITLAB_TOKEN=your-gitlab-pat
GITLAB_TEAM_DATA_PROJECT_ID=82624331
IPA_BIND_DN=your-ipa-bind-dn
IPA_BIND_PASSWORD=your-ipa-bind-password

# Upstream Pulse
# GITHUB_TEAM_TOKEN defaults to GITHUB_TOKEN when left empty.
GITHUB_TEAM_TOKEN=
GITHUB_TEAM_ORG=opendatahub-io
ORG_NAME="Red Hat"
TEAM_EMAIL_DOMAIN=redhat.com
UPSTREAM_ADMIN_USERS=roster-sync-service
GOOGLE_AI_API_KEY=

# Optional CollectOSS connection (use a read-only PostgreSQL URL).
# 8Knot mapping: compose AUGUR_USERNAME/PASSWORD/HOST/PORT/DATABASE into
# COLLECTOSS_DATABASE_URL; map AUGUR_SCHEMA=augur_data to COLLECTOSS_SCHEMA=augur_data.
# AUGUR_LOGIN_ENABLED is 8Knot UI-only.
# Use host.docker.internal for a host tunnel (Docker or Podman >= 5.x).
# Linux tunnels must bind 0.0.0.0 so containers can reach them.
# Do not quote the URL; URL-encode special characters in the password (e.g. @ -> %40).
# COLLECTOSS_DATABASE_URL=postgresql://<readonly-user>:<password>@host.docker.internal:5411/augur
# COLLECTOSS_SCHEMA=data
# DEFAULT_DATA_SOURCE=github
# COLLECTOSS_FALLBACK_TO_GITHUB=true
